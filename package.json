{
  "name": "lasercut-studio",
  "version": "0.1.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/geom.test.ts --bundle --platform=node --format=esm --outfile=tests/out.mjs --log-level=warning && node tests/out.mjs",
    "test:dom": "esbuild src/main.ts --bundle --format=esm --outfile=tests/_main.mjs --log-level=warning && node tests/dom.test.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm run test && npm version --json > /dev/null || true",
    "sync": "node scripts/sync.mjs",
    "start": "node scripts/serve.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Браузерный векторный редактор для лазерной резки: мм 1:1, DXF/SVG (прототип S1)",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
